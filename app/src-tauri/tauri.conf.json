{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radial Convert",
  "version": "0.1.0",
  "identifier": "com.radialconvert.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Radial Convert",
        "visible": false,
        "width": 640,
        "height": 760,
        "minWidth": 480,
        "minHeight": 520,
        "center": true
      },
      {
        "label": "toast",
        "url": "index.html#toast",
        "width": 420,
        "height": 72,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "acceptFirstMouse": true
      },
      {
        "label": "overlay",
        "url": "index.html#overlay",
        "width": 264,
        "height": 264,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
